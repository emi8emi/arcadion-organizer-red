# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: sync slash commands to one server only (appears instantly).
# Leave empty to sync globally (can take up to an hour to show up).
GUILD_ID=

# Optional: role id that counts as "organizer" (people with Manage Server always count).
ORGANIZER_ROLE_ID=

# Optional: where the SQLite file lives (default comes from config.json).
DB_PATH=
