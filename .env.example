# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: your home server. Commands sync to it only (appears instantly) and the three values below belong to it.
# Leave empty to run in every server: commands sync globally (up to an hour) and each server is set up with /settings.
GUILD_ID=

# Optional: role id that counts as "organizer" (people with Manage Server always count).
ORGANIZER_ROLE_ID=

# Optional: channel id where the bot reminds organizers to run /draft export after a day's cutoff.
REMINDER_CHANNEL_ID=

# Optional: channel id where the bot creates the threads for each party after confirming the draft.
PARTIES_CHANNEL_ID=

# The PostgreSQL database shared with the dashboard (the dashboard owns the schema and migrates it).
# Both programs need the same URL. For a database on another machine add ?sslmode=require.
DATABASE_URL=postgresql://raidbot:change-me@localhost:5432/raidbot

FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=

DEBUG_COMMANDS=0