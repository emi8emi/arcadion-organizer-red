# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: sync slash commands to one server only (appears instantly).
# Leave empty to sync globally (can take up to an hour to show up).
GUILD_ID=

# Optional: role id that counts as "organizer" (people with Manage Server always count).
ORGANIZER_ROLE_ID=

# Optional: channel id where the bot reminds organizers to run /draft export after a day's cutoff.
REMINDER_CHANNEL_ID=

# Optional: channel id where the bot creates the threads for each party after confirming the draft.
PARTIES_CHANNEL_ID=

# Optional: where the SQLite file lives (default comes from config.json).
DB_PATH=

FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=

DEBUG_COMMANDS=0