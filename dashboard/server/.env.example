# Copy this file to ".env" and fill it in. Never commit .env.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ORGANIZER_ROLE_ID=

# Long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Where the browser reaches the site. Dev: the Svelte dev server. Later: your Tailscale Funnel URL.
BASE_URL=http://localhost:5173
# Set to true once BASE_URL is https
COOKIE_SECURE=false
# The database file shared with the bot (the dashboard owns its schema and migrates it on startup).
# Leave empty for <repo>/raidbot.sqlite3, the bot's default. A relative path is relative to the repo root.
# If you set it here, set the same DB_PATH in the bot's .env.
DB_PATH=
