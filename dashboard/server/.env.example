# Copy this file to ".env" and fill it in. Never commit .env.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ORGANIZER_ROLE_ID=

# Long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Where the browser reaches the site. Dev: the Svelte dev server. Later: your Tailscale Funnel URL.
BASE_URL=http://localhost:5173
# Set to true once BASE_URL is https
COOKIE_SECURE=false
# The PostgreSQL database shared with the bot. Give the bot's .env the same URL. The dashboard owns the schema
# and migrates it on startup. For a database on another machine add ?sslmode=require (or verify-full).
DATABASE_URL=postgresql://raidbot:change-me@localhost:5432/raidbot
